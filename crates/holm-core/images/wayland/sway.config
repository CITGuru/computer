# sway reads no environment here, so `computer-screen` fills in the geometry.
output HEADLESS-1 resolution %WIDTH%x%HEIGHT% position 0 0

# Substituted per screen from whether Xwayland is installed.
xwayland %XWAYLAND%

# sway names its IPC socket after its own process, so it is recorded here.
exec_always printf '%s' "$SWAYSOCK" > %SOCKFILE%

default_border none
default_floating_border none
titlebar_padding 1
gaps inner 0
gaps outer 0

# A blank output is a black screenshot that reads as a broken capture.
output HEADLESS-1 background #111113 solid_color
