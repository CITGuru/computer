# No compositor: `xcompmgr` in Xvfb leaves repaint artifacts in screenshots.

# background 1: the panel
# Small radius and low alpha: without a compositor, corners draw at one bit.
rounded = 9
border_width = 1
background_color = #e6e9ee 30
border_color = #ffffff 22

# background 2: a launcher icon
rounded = 8
border_width = 0
background_color = #ffffff 0

# No `panel_margin`: autohide would leave the strip above the edge, out of the pointer's reach.
panel_items = L
panel_monitor = all
panel_position = bottom center horizontal
panel_size = %PANELWIDTH% 62
panel_margin = 0 0
panel_padding = 18 9 8
panel_background_id = 1
panel_layer = top
strut_policy = none

autohide = 1
autohide_show_timeout = 0.15
autohide_hide_timeout = 0.9
autohide_height = 2

launcher_padding = 0 0 8
launcher_background_id = 2
launcher_icon_size = 44
launcher_icon_theme = hicolor
launcher_item_app = /usr/share/applications/computer-terminal.desktop
launcher_item_app = /usr/share/applications/computer-browser.desktop
%APPS%
launcher_tooltip = 1
