# One headless output, at the size the box was started with.
#
# `%WIDTH%` and `%HEIGHT%` are replaced per screen by `computer-screen`: sway
# reads no environment in its configuration, so a template is the only way the
# geometry the box was given reaches the output.
output HEADLESS-1 resolution %WIDTH%x%HEIGHT% position 0 0

# No X applications in this image, and starting Xwayland for none of them
# costs a second server and the memory under it.
xwayland disable

# **The socket path, recorded where anything can find it.** sway names its IPC
# socket after its own process, so nothing that did not start it can guess the
# name. Everything in this image reaches sway through this file instead.
exec_always printf '%s' "$SWAYSOCK" > %SOCKFILE%

# A screenshot is the work, so nothing decorative belongs in it.
default_border none
default_floating_border none
titlebar_padding 1
gaps inner 0
gaps outer 0

# A blank output is a black screenshot that reads as a broken capture. This is
# the same colour the X11 image sets its root window to.
output HEADLESS-1 background #111113 solid_color

# Nothing in this image is driven by a person at the keyboard, and a stray
# chord that closed the compositor would take the box with it.
